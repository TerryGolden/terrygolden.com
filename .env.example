# ===========================================
# Terry Golden Website - Environment Variables
# ===========================================

# Supabase Configuration (Required)
# Get these from: https://supabase.com/dashboard/project/ogmcctnpxgemlvulhtom/settings/api
VITE_SUPABASE_URL=https://ogmcctnpxgemlvulhtom.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ===========================================
# Supabase Edge Function Secrets
# Set these in: Supabase Dashboard > Edge Functions > Secrets
# ===========================================

# Spotify API (for fetching album metadata and releases)
# Get from: https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Instagram API (for social feed integration)
# Get from: Facebook Developer Portal
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# Optional: Press Discovery APIs
# NEWSAPI_API_KEY=your_newsapi_key
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your_search_engine_id
